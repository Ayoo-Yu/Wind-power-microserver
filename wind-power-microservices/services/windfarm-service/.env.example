# Wind Farm Management Service Configuration

# Application Settings
APP_NAME="Wind Farm Management Service"
APP_VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8001

# Database Settings
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/windfarm_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis Settings
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=50

# Security Settings
SECRET_KEY=your-very-long-secret-key-here-make-it-random-and-secure
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Service Discovery
SERVICE_DISCOVERY_ENABLED=false
CONSUL_HOST=localhost
CONSUL_PORT=8500
CONSUL_SERVICE_NAME=windfarm-service

# Health Check
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_MAX_ENTRIES=1000000

# Performance Monitoring
METRICS_ENABLED=false
METRICS_PORT=9090

# Feature Flags
ENABLE_REAL_TIME_DATA=true
ENABLE_NOTIFICATIONS=true
ENABLE_CACHE=true

# Environment
ENVIRONMENT=development