# Application Settings
APP_NAME="Power Prediction Service"
APP_VERSION="1.0.0"
HOST=0.0.0.0
PORT=8004
DEBUG=false

# Database Settings
DATABASE_URL=postgresql+asyncpg://postgres:password@power-prediction-postgres:5432/power_prediction_db
REDIS_URL=redis://power-prediction-redis:6379

# Kafka Settings
KAFKA_BOOTSTRAP_SERVERS=power-prediction-kafka:9092
KAFKA_TOPICS_POWER_PREDICTION=power-predictions
KAFKA_TOPICS_POWER_DATA=power-data
KAFKA_TOPICS_WEATHER_DATA=weather-data
KAFKA_TOPICS_SCADA_DATA=scada-data

# Machine Learning Settings
ML_MODELS_PATH=/app/models
ML_MODEL_UPDATE_INTERVAL=3600
ML_TRAINING_BATCH_SIZE=1000
ML_PREDICTION_HORIZON_HOURS=72

# Model Configuration
ENABLE_LSTM_MODEL=true
ENABLE_XGBOOST_MODEL=true
ENABLE_RANDOM_FOREST_MODEL=true
ENABLE_ENSEMBLE_MODEL=true

# API Settings
WEATHER_API_URL=http://meteorological-service:8003
SCADA_API_URL=http://scada-data-service:8002
WIND_FARM_API_URL=http://wind-farm-service:8001

# Security Settings
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Monitoring Settings
PROMETHEUS_METRICS_ENABLED=true
METRICS_PORT=8000

# Logging Settings
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://api-gateway:8000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=1000
RATE_LIMIT_PER_HOUR=10000

# Data Retention
PREDICTION_HISTORY_DAYS=365
MODEL_PERFORMANCE_HISTORY_DAYS=90

# Training Settings
AUTO_RETRAINING_ENABLED=true
RETRAINING_INTERVAL_HOURS=168
MIN_TRAINING_SAMPLES=10000

# Feature Engineering
ENABLE_FEATURE_ENGINEERING=true
FEATURE_LAG_HOURS=24
FEATURE_ROLLING_WINDOWS=3,6,12,24