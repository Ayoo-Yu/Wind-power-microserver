# Application Settings
APP_NAME="Report Service"
APP_VERSION="1.0.0"
HOST=0.0.0.0
PORT=8005
DEBUG=false

# Database Settings
DATABASE_URL=postgresql+asyncpg://postgres:password@report-postgres:5432/report_db
REDIS_URL=redis://report-redis:6379

# Kafka Settings
KAFKA_BOOTSTRAP_SERVERS=report-kafka:9092
KAFKA_TOPICS_REPORTS=reports
KAFKA_TOPICS_POWER_PREDICTIONS=power-predictions
KAFKA_TOPICS_WEATHER_DATA=weather-data
KAFKA_TOPICS_SCADA_DATA=scada-data

# Report Generation Settings
REPORT_TEMPLATES_PATH=/app/templates
REPORT_OUTPUT_PATH=/app/reports
REPORT_CACHE_TTL=3600
MAX_REPORT_SIZE_MB=50

# Report Types Configuration
ENABLE_PDF_REPORTS=true
ENABLE_EXCEL_REPORTS=true
ENABLE_HTML_REPORTS=true
ENABLE_CHARTS=true

# API Settings
POWER_PREDICTION_API_URL=http://power-prediction-service:8004
WEATHER_API_URL=http://meteorological-service:8003
SCADA_API_URL=http://scada-data-service:8002
WIND_FARM_API_URL=http://wind-farm-service:8001

# Security Settings
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Monitoring Settings
PROMETHEUS_METRICS_ENABLED=true
METRICS_PORT=8000

# Logging Settings
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://api-gateway:8000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=1000
RATE_LIMIT_PER_HOUR=10000

# Report Scheduling
ENABLE_SCHEDULED_REPORTS=true
REPORT_SCHEDULER_INTERVAL=300

# Data Retention
REPORT_HISTORY_DAYS=365
TEMP_FILE_CLEANUP_INTERVAL=86400

# Chart Configuration
CHART_DEFAULT_WIDTH=1200
CHART_DEFAULT_HEIGHT=600
CHART_DPI=150

# Email Settings (for report delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@windfarm.com

# External Integrations
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=