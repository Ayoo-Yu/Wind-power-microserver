[Unit]
Description=ECMWF Processor Service
# 如果脚本需要网络，确保在网络服务后启动
After=network.target

[Service]
# --- !! 重要配置 !! ---
# 运行脚本的用户和组（推荐使用非 root 用户）
User=root   
Group=root
# 脚本所在的目录 (绝对路径)
WorkingDirectory=/ECMWF
# 启动脚本的命令 (使用绝对路径！)
# 如果使用虚拟环境 (推荐):
ExecStart=/root/anaconda3/envs/ecmwf_env/bin/python /ECMWF/ecmwf_processor_process.py
# 如果不使用虚拟环境 (确保 python3 指向正确的解释器):
# ExecStart=/usr/bin/python3 /path/to/your/script/directory/ecmwf_processor_process.py
# --- !! 重要配置 !! ---

# 进程失败后的重启策略
Restart=always
# 重启间隔（秒）
RestartSec=10
# 将标准输出和错误输出重定向到 systemd journal
StandardOutput=journal
StandardError=journal
# (可选) 设置脚本需要的环境变量
# Environment="API_KEY=your_api_key"
# Environment="DB_HOST=localhost"

[Install]
# 定义在哪个系统运行级别下启用该服务（多用户模式）
WantedBy=multi-user.target