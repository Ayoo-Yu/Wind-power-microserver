# Wind Power Forecast - Deployment Environment Variables
# Copy this file to .env and modify values before deployment.

# Database password (used by both kingbase and backend)
DB_PASSWORD=change-me-in-production

# Flask secret key (used for JWT signing)
SECRET_KEY=change-me-in-production

# Flower monitoring (optional, remove celery-flower section if not needed)
FLOWER_USER=admin
FLOWER_PASSWORD=change-me-in-production

# 发布包内的精确镜像版本。离线导出脚本会自动改写这些值。
FRONTEND_IMAGE=wind-power-frontend:v250715_1.0
PREDICTION_IMAGE=wind-power-celery-worker:latest
DATABASE_IMAGE=kingbase_v009r001c002b0014_single_x86:v1

# 场站部署能力声明
DEPLOYMENT_MODE=field
SCADA_REALTIME_ENABLED=false
NWP_INGESTION_ENABLED=false
PHYSICAL_SIMULATION_ENABLED=false
REPORT_SCHEDULER_MODE=celery

# 统一跨区接入接口。启用时必须更换独立随机令牌。
INTEGRATION_API_ENABLED=false
INTEGRATION_API_TOKEN=change-me-before-enabling
