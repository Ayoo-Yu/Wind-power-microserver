[Unit]
Description=Wind Power Cross Zone Data Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=windpower-agent
Group=windpower-agent
EnvironmentFile=-/etc/windpower-zone-agent.env
Environment=PYTHONPATH=/opt/windpower-zone-agent/current
ExecStart=/opt/windpower-zone-agent/current/run-agent.sh
Restart=always
RestartSec=5
StateDirectory=windpower-zone-agent
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/windpower-zone-agent /data/windpower

[Install]
WantedBy=multi-user.target
