# 代理身份与本地可靠队列
AGENT_SOURCE=zone3.nwp
AGENT_FARM_CODE=CF
AGENT_DATA_TYPE=nwp
AGENT_SPOOL=/var/lib/windpower-zone-agent/spool

# 可选的落地目录扫描。留空时只发送已经入队的数据包。
AGENT_INPUT_DIR=/data/windpower/incoming
AGENT_PATTERN=*.dat
AGENT_RECURSIVE=false
AGENT_MINIMUM_AGE_SECONDS=3

# 下一跳传输模式：http 或 directory
AGENT_TARGET_MODE=http
AGENT_TARGET_URL=http://10.0.0.20:5000/api/v1/integration/packages
AGENT_TARGET_SPOOL=/data/windpower/next-hop
INTEGRATION_API_TOKEN_FILE=/etc/windpower-zone-agent.token

AGENT_POLL_SECONDS=2
AGENT_RETRY_BASE_SECONDS=5
AGENT_RETRY_MAX_SECONDS=300
