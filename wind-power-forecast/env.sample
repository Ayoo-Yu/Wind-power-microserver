# 应用运行环境
APP_ENV=development

# 数据库 (Kingbase / PostgreSQL 方言)
DB_HOST=kingbase
DB_PORT=54321
DB_USER=system
DB_PASSWORD=12345678ab
DB_NAME=windpower

# MinIO 对象存储
MINIO_ENDPOINT=minio
MINIO_PORT=9900
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
DEFAULT_WIND_FARM_CODE=default-farm

# 队列 & 缓存
REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=
CELERY_TASK_DEFAULT_QUEUE=windpower-default
CELERY_TIMEZONE=Asia/Shanghai

# Flask / 安全
SECRET_KEY=replace-me
FLASK_DEBUG=true
JWT_SECRET_KEY=wind-power-forecast-secret-key
JWT_ACCESS_TOKEN_EXPIRES_HOURS=12

# 可选路径覆盖（如果不设置则使用后端目录内默认路径）
#UPLOAD_FOLDER=
#DOWNLOAD_FOLDER=
#MODEL_DIR=
#SCALER_DIR=
#METRICS_DIR=

# CORS 设置
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,Accept,Origin


