# ===================================================================
# Python Data Science & Web Project .gitignore
# 为您的风电功率预测平台量身定制的终极版
# ===================================================================

# 1. 核心原则：忽略所有非代码的、可生成的文件

# 2. 项目特定忽略规则 (根据您的项目定制)
# =================================================
# 忽略由 specstory 插件/工具生成的历史记录
.specstory/

# 忽略您项目中自定义的日志和标志文件
*.log
*.done.flag
*.train.flag
*.predict.done.flag


# 3. 数据与大型文件 (绝不上传)
# =================================================
# 明确指定的数据文件夹
data/
dataset/
raw_data/

# 按文件类型忽略常见数据格式
*.csv
*.json
*.xml
*.xls
*.xlsx
*.pkl
*.parquet

# 忽略大型压缩包
*.zip
*.rar
*.tar
*.gz


# 4. 模型与输出 (本地生成，无需共享)
# =================================================
# 存放训练好的模型、检查点和输出结果的文件夹
models/
checkpoints/
output/
reports/

# 按文件类型忽略常见模型格式
*.model
*.model.joblib
*.scaler.joblib
*.pth
*.h5
*.onnx


# 5. Python 虚拟环境 (本地环境，严禁上传)
# =================================================
venv/
.venv/
env/
wind-power-env/


# 6. Python & IDE 缓存/配置 (自动生成，与项目无关)
# =================================================
# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# IDE 配置文件
.vscode/
.idea/

# Jupyter Notebook 检查点
.ipynb_checkpoints


# 7. 操作系统与通用临时文件
# =================================================
# macOS
.DS_Store
# Windows
Thumbs.db
# Linux & others
*.swp
*.tmp