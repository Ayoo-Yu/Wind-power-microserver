# ===================================================================
# Python Data Science & Web Project .gitignore
# 为您的风电功率预测平台量身定制的终极版
# ===================================================================

# 1. 核心原则：忽略所有非代码的、可生成的文件

# 2. 项目特定忽略规则 (根据您的项目定制)
# =================================================
# 忽略由 specstory 插件/工具生成的历史记录
.specstory/

# 忽略您项目中自定义的日志和标志文件
*.log
*.done.flag
*.train.flag
*.predict.done.flag


# 3. 数据与大型文件 (绝不上传)
# =================================================
# 明确指定的数据文件夹
data/
dataset/
raw_data/

# 按文件类型忽略常见数据格式
*.csv
*.json
*.xml
*.xls
*.xlsx
*.pkl
*.parquet

# SCADA 测试环境的版本化契约与确定性场景属于源代码。
!simulation/scada-test/config/
!simulation/scada-test/config/*.json

# 忽略大型压缩包
*.zip
*.rar
*.tar
*.gz


# 4. 模型与输出 (本地生成，无需共享)
# =================================================
# 存放训练好的模型、检查点和输出结果的文件夹
models/
checkpoints/
output/
reports/

# 按文件类型忽略常见模型格式
*.model
*.model.joblib
*.scaler.joblib
*.pth
*.h5
*.onnx


# 5. Python 虚拟环境 (本地环境，严禁上传)
# =================================================
venv/
.venv/
env/
wind-power-env/


# 6. Python & IDE 缓存/配置 (自动生成，与项目无关)
# =================================================
# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# IDE 配置文件
.vscode/
.idea/

# Jupyter Notebook 检查点
.ipynb_checkpoints


# 7. 操作系统与通用临时文件
# =================================================
# macOS
.DS_Store
# Windows
Thumbs.db
# Linux & others
*.swp
*.tmp

# 8. 敏感文件 (密钥、凭据)
# =================================================
# SSH 私钥
id_rsa
id_rsa.pub
*.pem
simulation/ssh/

# 环境变量文件（含真实密码）
.env
simulation/.env
**/.env
# 保留 .env.example 供参考
!.env.example

# 9. 增强的日志和标志文件忽略规则
# =================================================
# 日志目录
logs/
# 带日期的日志文件
*.log.*
# 递归匹配所有目录下的日志文件
**/*.log.*
# 标志文件模式
**/*_done.flag
**/*_train.flag
**/*.lock
*.flag

# 10. 工具和构建产物
# =================================================
node_modules/
.playwright-mcp/
.superpowers/
wind-power-forecast/frontend/dist/
wind-power-forecast/backend/results/

# 11. 备份和重复文件
# =================================================
*.backup
*.bak
*.old
*.orig
*copy*.py
*copy*.ini

# 12. 研究数据和大型媒体
# =================================================
云南风机数据整理/
bg.mp4
*.mp4
login-page-check.png
dashboard-fix-verification.png

# 13. 根目录临时/测试产物
# =================================================
*_test.log
template_predict_input.csv

# 本地开发进程状态
**/.local-run/

