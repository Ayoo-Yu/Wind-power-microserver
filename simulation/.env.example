# 模拟生产环境配置
# 复制此文件为 .env 并填入真实值：cp .env.example .env

# 腾讯云服务器（Zone3拉取目标）
TENCENT_ZONE3_IP=<YOUR_SERVER_IP>
TENCENT_ZONE3_PORT=22
TENCENT_ZONE3_USER=root

# 数据拉取间隔（分钟）
FETCH_INTERVAL_MINUTES=15

# SCADA模拟器配置
SIMULATOR_PORT=2404
POWER_MIN=0
POWER_MAX=200
UPDATE_INTERVAL_SECONDS=10

# 数据库
DB_HOST=kingbase
DB_PORT=54321
DB_USER=system
DB_PASSWORD=<YOUR_DB_PASSWORD>
DB_NAME=windpower

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<YOUR_MINIO_PASSWORD>

# ECMWF DB摄取开关
DB_INGEST_ENABLED=true
DB_PREDICTION_ENABLED=true
FARM_CODE=DEFAULT_FARM

# Autopredict 本地开发 DB 连接（覆盖 Docker 服务名）
DB_HOST_OVERRIDE=localhost
DB_PORT_OVERRIDE=15432
