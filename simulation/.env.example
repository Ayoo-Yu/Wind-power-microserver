# 妯℃嫙鐢熶骇鐜閰嶇疆
# 澶嶅埗姝ゆ枃浠朵负 .env 骞跺～鍏ョ湡瀹炲€硷細cp .env.example .env

# 鑵捐浜戞湇鍔″櫒锛圸one3鎷夊彇鐩爣锛?TENCENT_ZONE3_IP=<YOUR_SERVER_IP>
TENCENT_ZONE3_PORT=22
TENCENT_ZONE3_USER=root

# 鏁版嵁鎷夊彇闂撮殧锛堝垎閽燂級
FETCH_INTERVAL_MINUTES=15

# SCADA妯℃嫙鍣ㄩ厤缃?SIMULATOR_PORT=2404
POWER_MIN=0
POWER_MAX=200
UPDATE_INTERVAL_SECONDS=10

# 鏁版嵁搴?DB_HOST=kingbase
DB_PORT=54321
DB_USER=system
DB_PASSWORD=<YOUR_DB_PASSWORD>
DB_NAME=windpower


# ECMWF DB鎽勫彇寮€鍏?DB_INGEST_ENABLED=true
DB_PREDICTION_ENABLED=true
FARM_CODE=DEFAULT_FARM

# Autopredict 鏈湴寮€鍙?DB 杩炴帴锛堣鐩?Docker 鏈嶅姟鍚嶏級
DB_HOST_OVERRIDE=localhost
DB_PORT_OVERRIDE=15432
